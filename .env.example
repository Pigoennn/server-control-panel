# Config for the control API (go run ./cmd/api). Copy to .env (untracked)
# and fill in. Never commit .env.

# Shared secret the bot sends as "Authorization: Bearer <token>".
# At least 32 characters. Generate one with:
#   openssl rand -hex 32
API_TOKEN=

# Where the API listens. Keep it on localhost.
API_ADDR=127.0.0.1:8080

# The Docker socket proxy (deploy/docker-proxy). Never the raw socket.
DOCKER_HOST=tcp://127.0.0.1:2375

# RCON, for the player list. The password must match MC_RCON_PASSWORD in
# deploy/minecraft/.env and deploy/minecraft-vanilla/.env.
MC_RCON_ADDR=127.0.0.1:25575
MC_RCON_PASSWORD=
