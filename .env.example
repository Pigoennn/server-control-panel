# Config for the control API (go run ./cmd/api) and the Discord bot
# (go run ./cmd/bot). Copy to .env (untracked) and fill in. Never commit .env.

# --- Control API ---

# Shared secret the bot sends as "Authorization: Bearer <token>".
# At least 32 characters. Generate one with:
#   openssl rand -hex 32
API_TOKEN=

# Where the API listens. Keep it on localhost.
API_ADDR=127.0.0.1:8080

# The Docker socket proxy (deploy/docker-proxy). Never the raw socket.
DOCKER_HOST=tcp://127.0.0.1:2375

# RCON, for the player list. The password must match MC_RCON_PASSWORD in
# deploy/minecraft/.env and deploy/minecraft-vanilla/.env.
MC_RCON_ADDR=127.0.0.1:25575
MC_RCON_PASSWORD=

# --- Discord bot (also uses API_TOKEN above) ---

# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# The server the bot lives in (right-click the server → Copy Server ID).
# Commands are registered there and update instantly. Leave empty only to
# register them globally instead, for a DM with the bot (updates can take
# up to an hour to show).
DISCORD_GUILD_ID=

# Who may use the bot: comma-separated Discord user IDs (17-20 digits;
# Developer Mode → right-click a user → Copy User ID). Admins are allowed
# automatically. The bot refuses to start if both lists are empty.
ALLOWED_IDS=
# Admins can stop a server while people are on it (with a 5-minute
# in-game warning) and cancel that countdown.
ADMIN_IDS=

# Where the bot finds the API. This is the default.
API_URL=http://127.0.0.1:8080

# Optional. The address the bot tells friends to join once a server is up.
JOIN_ADDRESS=scooter-swizzle.tun.ply.gg
