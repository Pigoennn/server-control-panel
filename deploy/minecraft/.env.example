# Copy to .env (untracked) and fill in. Compose reads .env from this folder.
#
# RCON password for this server. Must match MC_RCON_PASSWORD in the
# repo-root .env, which the API uses. Generate one with:
#   openssl rand -hex 24
# If the password contains a `$`, write it as `$$` here (Compose treats `$`
# as the start of a variable). A hex password never does.
MC_RCON_PASSWORD=
